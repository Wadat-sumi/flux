# Non-secret local configuration only. Real credentials belong in Azure Key Vault.
PORT=3001
PUBLIC_ORIGIN=http://127.0.0.1:5173
FLUX_DB_DIR=.flux-data/postgres
FLUX_ALLOW_REGISTRATION=true
# After the joint Azure review and authorized developer login:
FLUX_KEY_VAULT_URL=
FLUX_ENABLE_TOMTOM=false
TOMTOM_SECRET_NAME=tomtom-api-key
# Keep false for isolated local persistence; enable only for a reviewed test database.
FLUX_USE_CLOUD_DATABASE=false
# Azure injects actual credentials through managed-identity Key Vault references.
